{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["LONORA_OTA_URL", "LONORA_OTA_CHANNEL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@lonora/ui-web#build": {
      "outputs": []
    },
    "@lonora/chat-ui#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@lonora/ui-tokens#build": {
      "outputs": []
    },
    "@lonora/contracts#build": {
      "outputs": []
    },
    "@lonora/core#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
