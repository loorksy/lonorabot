{"v":2,"kind":"calculator","title":"حاسبة حجم الصفقة","sub":"جرّب الأرقام بنفسك","icon":"chart"}
{"state":{"risk":1,"balance":10000,"stop":20,"side":"buy","lev":"100","show":false},"calc":{"cash":"$balance*$risk/100","lots":"$cash/($stop*10)"}}
{"type":"Grid","cols":2,"children":[{"type":"Stat","label":"المخاطرة","value":"{@Fmt($cash,0)} $","sub":"من الرصيد","trend":"$risk>2?'up':'down'","tone":"accent","icon":"trend"},{"type":"Stat","label":"الحجم","value":"{@Fmt($lots,2)} لوت"}]}
{"type":"Card","title":"الفكرة","icon":"info","children":[{"type":"Title","text":"قاعدة ثابتة"},{"type":"Badge","text":"تقدير","tone":"good","icon":"check"}]}
{"type":"Segmented","bind":"side","label":"الاتجاه","options":[{"value":"buy","label":"شراء"},{"value":"sell","label":"بيع"}]}
{"type":"Number","bind":"balance","label":"الرصيد","suffix":"$","required":true}
{"type":"More","label":"المزيد","children":[{"type":"Select","bind":"lev","label":"الرافعة","options":[{"value":"50","label":"1:50"},{"value":"100","label":"1:100"},{"value":"200","label":"1:200"},{"value":"500","label":"1:500"},{"value":"1000","label":"1:1000"}]},{"type":"Slider","bind":"risk","label":"المخاطرة %","min":0.5,"max":5,"step":0.5,"show":"{$risk}%"},{"type":"Text","text":"**{@Fmt($lots,2)}** لوت عند وقف {$stop} نقطة","tone":"muted","size":"sm"},{"type":"Markdown","text":"- المخاطرة من الرصيد\n- الوقف بالنقاط"},{"type":"Note","tone":"warn","when":"$risk>2","text":"مخاطرة مرتفعة"},{"type":"KeyValue","rows":[["الرصيد","{@Fmt($balance,0)} $"],["الوقف","{$stop}"]]},{"type":"Col","children":[{"type":"Divider"},{"type":"Text","when":"$show","text":"تفاصيل إضافية"}]},{"type":"Row","children":[{"type":"Button","label":"2%","action":{"do":"set","key":"risk","value":2}},{"type":"Button","label":"التفاصيل","action":{"do":"toggle","key":"show"}},{"type":"Button","label":"إعادة","action":{"do":"reset"}},{"type":"Button","label":"نسخ","icon":"copy","action":{"do":"copy","text":"{@Fmt($lots,2)} لوت"}},{"type":"Button","label":"المصدر","action":{"do":"open","url":"https://example.com/position-size"}},{"type":"Button","label":"السوق","action":{"do":"go","route":"market"}}]}]}
{"type":"Button","label":"اشرح الحساب","style":"primary","full":true}
{"why":"حاسبة تجرّب فيها الأرقام بنفسك وترى الحجم فورًا؛ أوضح من شرح نصي.","fallback":"الحجم = الرصيد × المخاطرة ÷ (الوقف × 10)."}
