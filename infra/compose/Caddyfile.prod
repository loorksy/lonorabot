{$LONORA_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        Permissions-Policy "microphone=(self), camera=()"
    }
    handle {
        reverse_proxy api:8000
    }
}
