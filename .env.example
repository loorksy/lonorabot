# bash scripts/install.sh creates missing local keys without printing them.
LONORA_DATABASE_URL=postgresql+asyncpg://lonora:lonora@127.0.0.1:5432/lonora
LONORA_ENCRYPTION_KEY=
LONORA_BOOTSTRAP_TOKEN=
LONORA_COOKIE_SECURE=false
LONORA_ALLOWED_ORIGIN=http://localhost:8000
LONORA_ARTIFACT_ROOT=.runtime/artifacts
# Optional only when serving an Expo Web shell separately: directory of the Web
# build containing chart-runtime/index.html and the single charting_library tree.
# Otherwise the shared chart renderer uses LONORA_WEB_ROOT (apps/web/dist).
# LONORA_CHART_RENDERER_ROOT=apps/web/dist
LONORA_WORKER_POLL_SECONDS=0.5
LONORA_RUN_LEASE_SECONDS=120
LONORA_MAXIMUM_TOOL_ROUNDS=24
LONORA_MAXIMUM_SUBAGENTS=4
# Production Compose requires a strong password; set before deploying.
LONORA_POSTGRES_PASSWORD=
LONORA_DOMAIN=
# Optional provider keys; the owner can save encrypted keys in the Web settings.
LONORA_OPENAI_API_KEY=
LONORA_ANTHROPIC_API_KEY=
LONORA_DEEPSEEK_API_KEY=
LONORA_ZAI_API_KEY=
LONORA_OPENROUTER_API_KEY=
LONORA_WEBHOOK_SECRET=

# Public Android release built and verified by apps/mobile/scripts/android-release.py.
LONORA_ANDROID_APK_PATH=.runtime/releases/android/lonora.apk

# Passkeys: HTTPS production origin must match the public app domain.
# These are PUBLIC release-certificate / Apple application identifiers, never signing keys.
# Native authorization remains UNCONFIGURED until these match the installed signed app.
LONORA_PASSKEY_ANDROID_PACKAGE=ai.lonora.mobile
LONORA_PASSKEY_ANDROID_FINGERPRINTS=[]
LONORA_PASSKEY_IOS_APP_IDS=[]
