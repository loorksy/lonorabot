 "flows": [
  {
   "id": "turn",
   "title": "One agent turn",
   "description": "A user message to the bot's reply.",
   "steps": [
    {
     "node": "web.components",
     "note": "User sends a message in a thread."
    },
    {
     "node": "server/routes/bot-messages.ts",
     "note": "POST handler stores the message and enqueues work."
    },
    {
     "node": "server/runtime/runtime.ts",
     "note": "tick() admits the assignment and dispatches it, with envelope and limits."
    },
    {
     "node": "server/turn-route.ts",
     "note": "Picks simple vs complex tier and the model."
    },
    {
     "node": "server/agents-turn.ts",
     "note": "Builds the per-turn tool environment and bearer."
    },
    {
     "node": "agent.engines",
     "note": "The bot's driver (claude, codex, chat...) runs the model."
    },
    {
     "node": "server/drivers/agents-bridge.ts",
     "note": "Engine tool calls come back to the harness over MCP."
    },
    {
     "node": "server/harness/registry.ts",
     "note": "Harness checks the bearer, runs the tool, returns results."
    },
    {
     "node": "web.state",
     "note": "Reply streams back over SSE and renders."
    }
   ]
  },
  {
   "id": "signin",
   "title": "Sign in with a ChatGPT or Claude subscription",
   "steps": [
    {
     "node": "web.components",
     "note": "User picks an engine in Settings and clicks Sign in."
    },
    {
     "node": "server/routes/sign-in.ts",
     "note": "Route starts a provider authentication session."
    },
    {
     "node": "server/provider-auth-sessions.ts",
     "note": "Tracks the pending session and status."
    },
    {
     "node": "server/drivers/codex-device-auth.ts",
     "note": "codex login --device-auth yields a link and code."
    },
    {
     "node": "server/drivers/claude-login-auth.ts",
     "note": "claude auth login: link shown, pasted code goes to stdin."
    },
    {
     "node": "server/engine-homes/sign-ins.ts",
     "note": "Credentials live in the engine's own home, never in app code."
    },
    {
     "node": "agent.catalog",
     "note": "Signed-in engines then list their models."
    }
   ]
  }
 ],
 "tour": [
  {
   "node": "agent.loop",
   "title": "The loop",
   "note": "Start at runtime.ts: store is the only state and tick() the only dispatch point."
  },
  {
   "node": "agent.engines",
   "title": "Engine drivers",
   "note": "Every provider implements ProviderDriver; builtIn.ts lists them."
  },
  {
   "node": "agent.catalog",
   "title": "Model catalog",
   "note": "A bundled manifest plus a startup cache gives a fixed model list."
  },
  {
   "node": "agent.auth",
   "title": "Sign-in",
   "note": "Subscription logins delegate to the vendors' own CLIs."
  },
  {
   "node": "agent.tools",
   "title": "Tools and approvals",
   "note": "Harness-served tools are scoped per turn and gated by approval modes."
  },
  {
   "node": "server.core",
   "title": "Composition root",
   "note": "index.ts wires everything."
  }
 ]
}